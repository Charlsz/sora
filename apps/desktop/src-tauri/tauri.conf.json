{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sora",
  "version": "0.1.0",
  "identifier": "dev.sora.app",
  "build": {
    "beforeDevCommand": "bun --filter @sora/web dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "bun --filter @sora/web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sora",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
