{
  "name": "sora",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source AI agent runtime and workspace",
  "type": "module",
  "workspaces": ["packages/*", "cli", "apps/*"],
  "scripts": {
    "sora": "bun cli/src/bin.ts",
    "desktop": "bun --filter @sora/desktop start",
    "desktop:dev": "bun --filter @sora/desktop dev",
    "desktop:build": "bun --filter @sora/desktop build",
    "dev:web": "bun --filter @sora/web dev",
    "build:web": "bun --filter @sora/web build",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.2"
  }
}
