{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun-types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@sora/core": ["./packages/core/src/index.ts"],
      "@sora/models": ["./packages/models/src/index.ts"],
      "@sora/tools": ["./packages/tools/src/index.ts"],
      "@sora/memory": ["./packages/memory/src/index.ts"],
      "@sora/agents": ["./packages/agents/src/index.ts"],
      "@sora/computer": ["./packages/computer/src/index.ts"],
      "@sora/permissions": ["./packages/permissions/src/index.ts"],
      "@sora/protocol": ["./packages/protocol/src/index.ts"],
      "@sora/skills": ["./packages/skills/src/index.ts"],
      "@sora/workflows": ["./packages/workflows/src/index.ts"],
      "@sora/api": ["./packages/api/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*", "cli/src/**/*", "tests/**/*"]
}
